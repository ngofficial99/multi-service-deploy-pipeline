# Windows VM startup script (rendered by Terraform). Downloads bootstrap.ps1
# from the (public) main repo over HTTPS and runs it. The bootstrap installs
# Docker + the GitHub Actions self-hosted runner; the runner then handles every
# deploy. Runs on every boot (idempotent), so a reboot self-heals.
$ErrorActionPreference = "Stop"
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$base = "C:\hanomi"
New-Item -ItemType Directory -Force -Path $base | Out-Null

$bootstrapUrl = "https://raw.githubusercontent.com/${github_repo}/main/deploy/windows/bootstrap.ps1"
Invoke-WebRequest -Uri $bootstrapUrl -OutFile "$base\bootstrap.ps1"

& "$base\bootstrap.ps1" `
  -GithubRepo "${github_repo}" `
  -RunnerSecret "${runner_secret}"
